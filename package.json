{
  "name": "cc-meter",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Tray gauge for Claude Code and Codex rate limits",
  "author": "silverdolphin863",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "serve": "node server.mjs",
    "test": "node test.mjs",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.silverdolphin863.ccmeter",
    "productName": "CC Meter",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "server.mjs",
      "public/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.png",
      "artifactName": "CCMeter-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CC Meter"
    }
  }
}
